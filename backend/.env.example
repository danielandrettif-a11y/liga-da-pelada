PORT=3001
ENABLE_GOAL_API=false
ENABLE_LEAGUE_API=false
ENABLE_IDENTITY_API=false
ENABLE_ROSTER_API=false
# Conta de conexão privada, com apenas os privilégios necessários e SET ROLE authenticated.
DATABASE_URL=postgresql://liga_backend:REPLACE_ME@supabase-db:5432/postgres
SUPABASE_INTERNAL_URL=http://api-gw:8000
# URL vista pelo navegador; usada nas URLs públicas de logo e capa.
SUPABASE_PUBLIC_URL=https://supabase.example.com
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
# Origem pública do Next.js usada nos callbacks de confirmação/OAuth/recuperação.
APP_PUBLIC_URL=http://localhost:3000
