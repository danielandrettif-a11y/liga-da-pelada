NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail real de contato para Safari/Apple Web Push. Não é segredo.
VAPID_SUBJECT=mailto:seu-email@exemplo.com
SUPABASE_SERVICE_ROLE_KEY=

# Alertas exatos de 00:30 e 00:00, inclusive com o PWA bloqueado.
# Gere em https://console.upstash.com/qstash e use uma string longa e aleatória
# no segredo do webhook. Nenhuma dessas chaves vai para o navegador.
QSTASH_TOKEN=
# Use https://qstash-us-east-1.upstash.io for a US token;
# leave empty for the default EU endpoint.
QSTASH_URL=
MATCH_TIMER_WEBHOOK_SECRET=

# Lembretes por e-mail do Cartola. O remetente precisa pertencer a um domínio
# validado no Resend. Gere o segredo de cancelamento como uma string aleatória.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Pelada BQ <cartola@seu-dominio.com>"
EMAIL_UNSUBSCRIBE_SECRET=
